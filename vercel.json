{
  "version": 2,
  "functions": {
    "api/agents/**/*.js": {
      "maxDuration": 300
    }
  },
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key",
    "ANTHROPIC_API_KEY": "@anthropic_api_key",
    "MONGODB_URI": "@mongodb_uri",
    "GUARDIAN_SECRET": "@guardian_secret"
  },
  "routes": [
    { "src": "^/$", "dest": "/frontend/index.html" },
    { "src": "^/(.*)$", "dest": "/frontend/$1" }
  ]
}
